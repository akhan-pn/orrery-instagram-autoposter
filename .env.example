# Airtable personal access token with data.records:read + data.records:write
# on the Orrery HQ base.  https://airtable.com/create/tokens
AIRTABLE_TOKEN=pat...

AIRTABLE_BASE_ID=appbfEP3OQhdnBzYN

# Instagram Business account id (NOT the @handle, NOT the Facebook Page id)
IG_USER_ID=1784...

# Long-lived Instagram/Facebook access token. Expires every 60 days.
META_ACCESS_TOKEN=EAA...

# Set to 1 to print what would be posted without posting it.
DRY_RUN=1

# ── LinkedIn (company page) ──────────────────────────────────────
# Pick ONE backend.
#
# Direct: free and unlimited, but posting as an organisation needs the
# w_organization_social scope from LinkedIn's Community Management API,
# which LinkedIn has to approve.
LINKEDIN_ORG_URN=urn:li:organization:0000000
LINKEDIN_ACCESS_TOKEN=

# Fallback via Publora: no LinkedIn approval needed, 15 posts/month free.
# Key: https://app.publora.com  →  platform id from Channels.
PUBLORA_API_KEY=
PUBLORA_LINKEDIN_PLATFORM_ID=linkedin-xxxxxxxx
